/*
=================================================
Creating Database and Schemas for Data Warehouse
=================================================
Script Purpose:
	This script recreates the 'DataWarehouse' database by dropping 
	it if it exists, then generates three distinct schemas within 
	it: 'bronz', 'silver', and 'gold'.

WARNING:
	Executing this script will result in the loss of all data and 
	structures within the 'DataWarehouse' database. Ensure that you 
	have backed up any necessary data before running this script.
*/



USE master;
GO

-- If exists Drop and Create Database 'DataWarehouse'
IF EXISTS (SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
	DROP DATABASE DataWarehouse;
END;
GO

-- Create Database 'DataWarehouse'
CREATE DATABASE DataWarehouse;

USE DataWarehouse;
GO

-- Create Schemas: bronz, silver, gold
CREATE SCHEMA bronz;
GO

CREATE SCHEMA silver;
GO

CREATE SCHEMA gold;
GO

--
